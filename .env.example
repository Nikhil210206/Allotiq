# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only — never expose to the browser

# Groq (optional layer — the app works without it)
GROQ_API_KEY=
GROQ_DISABLED=false                 # true = force fallbacks (rehearse this!)
GROQ_MODEL_PARSE=openai/gpt-oss-20b
GROQ_MODEL_REASON=openai/gpt-oss-120b
GROQ_MODEL_STT=whisper-large-v3-turbo

# App
NEXT_PUBLIC_APP_URL=                # the site's own URL (e.g. https://allotiq.vercel.app); fallback origin for sign-in links

# Jobs & demo
CRON_SECRET=                        # shared with the pg_cron job that calls /api/jobs/tick; tick refuses every call in production without it
DEMO_MODE=                          # set to 1 to allow /api/demo/login (role cards) in production; always on in dev
SEED_ANCHOR=                        # optional: pin the demo anchor (default: next Wed 13:50 IST)
